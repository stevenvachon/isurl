{
  "name": "isurl",
  "description": "Determine whether a value is a URL instance.",
  "version": "5.0.0-rc",
  "license": "MIT",
  "author": "Steven Vachon <contact@svachon.com> (https://svachon.com)",
  "repository": "github:stevenvachon/isurl",
  "type": "module",
  "exports": {
    ".": "./dist/isURL.js",
    "./lenient": "./dist/isURLLenient.js"
  },
  "dependencies": {
    "has-tostringtag": "^1.0.2",
    "is-object": "^1.0.2",
    "is-urlsearchparams": "^2.0.0-rc"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/is-object": "^1.0.5",
    "@types/node": "^26.2.0",
    "@types/whatwg-url": "^13.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "gzip-size-cli": "^5.1.0",
    "incomplete-symbol": "^2.0.0",
    "incomplete-url": "^5.0.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "terser": "^5.50.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "whatwg-url": "^17.1.0"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "npm run build:spellcheck && npm run build:lint && npm run build:typecheck:supplemental && npm run build:compile && npm run build:filesize",
    "build:compile": "tsc -p tsconfig.build.json",
    "build:filesize": "rollup dist/isURL.js --format umd --name isURL -p @rollup/plugin-node-resolve -p @rollup/plugin-commonjs | terser --compress 'passes=3' --mangle | gzip-size",
    "build:lint": "prettier --check '**/*.{config.js,json,md,ts}' '!coverage/**' '!dist/**'",
    "build:spellcheck": "cspell '**/*.{config.js,json,md,ts}' '!coverage/**' '!dist/**' '!node_modules/**' --no-progress",
    "build:typecheck:supplemental": "tsc --project tsconfig.check.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run test:watch -- --reporter=verbose --run",
    "test:watch": "vitest dev --coverage --coverage.exclude=src/*.test.ts --coverage.include=src/*.ts --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=text"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "uri",
    "url",
    "whatwg"
  ]
}
